# ---------------------------------------------------------------------------
# Globify Tech Institute — environment variables
# Copy this file to `.env.local` and fill in real values.
# Everything here is OPTIONAL: the site builds and deploys with all of it blank.
# ---------------------------------------------------------------------------

# Canonical origin. No trailing slash. Used for canonical tags, sitemap, OG, RSS.
NEXT_PUBLIC_SITE_URL=https://globifytech.com

# --- Analytics & tracking (all optional — scripts are skipped when unset) ----
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager container ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity project ID, e.g. abcdefghij
NEXT_PUBLIC_CLARITY_ID=

# Meta (Facebook) Pixel ID, e.g. 123456789012345
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# --- Search engine verification --------------------------------------------
# Google Search Console HTML-tag verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Yandex Webmaster verification token
NEXT_PUBLIC_YANDEX_VERIFICATION=

# --- Contact / lead routing -------------------------------------------------
# Where the contact form forwards leads. Leave blank to log-only in dev.
CONTACT_FORM_WEBHOOK_URL=
CONTACT_FORM_TO_EMAIL=admissions@globifytech.com

# Newsletter provider webhook (Mailchimp/Brevo/ConvertKit endpoint).
# Optional. Leads and subscribers are stored in Postgres either way; the
# webhook is now a notification, not the system of record.
NEWSLETTER_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Database + admin (/admin)
#
# Everything above stays optional. Everything below is REQUIRED to use the
# admin. Without DATABASE_URL the public site still builds and runs, falling
# back to the seed content in src/lib/*.ts and content/blog/, but the admin
# cannot sign in and contact-form submissions are only logged.
# ---------------------------------------------------------------------------

# MySQL / MariaDB connection string.
#   Hostinger (on the server) : mysql://USER:PASSWORD@localhost:3306/DB
#   Hostinger (from your PC)  : mysql://USER:PASSWORD@HOST:3306/DB
#   Local                     : mysql://root:root@localhost:3306/globify
#
# Percent-encode reserved characters in the password — a literal `+` must be
# written as %2B or the URI parser turns it into a space and auth fails.
#
# Connecting from outside the server needs your public IP added under
# hPanel > Databases > Remote MySQL first.
DATABASE_URL=

# Signing secret for the Auth.js session cookie.
# Generate one with:  npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET=

# Canonical origin for Auth.js callbacks. Only needed when the deployment URL
# is not auto-detected (most Vercel deploys can leave this blank).
# AUTH_URL=https://globifytech.com

# --- Admin account, read once by `npm run db:seed` --------------------------
# The password is hashed with bcrypt before it is stored; the plaintext never
# reaches the database. Re-running the seed updates the password in place, so
# this is also how you rotate it. Minimum 12 characters.
#
# QUOTE the password with single quotes if it contains `#`. dotenv treats an
# unquoted `#` as the start of a comment and will silently truncate the value,
# which produces a valid-looking hash of the wrong password.
#   ADMIN_PASSWORD='pa#ssword-with-hashes'
ADMIN_EMAIL=admin@globifytech.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

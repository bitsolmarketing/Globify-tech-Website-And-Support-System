# ---------------------------------------------------------------------------
# Globify Tech Institute — environment variables
# Copy this file to `.env.local` and fill in real values.
# Everything here is OPTIONAL: the site builds and deploys with all of it blank.
# ---------------------------------------------------------------------------

# Canonical origin. No trailing slash. Used for canonical tags, sitemap, OG, RSS.
NEXT_PUBLIC_SITE_URL=https://globifytech.com

# --- Analytics & tracking (all optional — scripts are skipped when unset) ----
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager container ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity project ID, e.g. abcdefghij
NEXT_PUBLIC_CLARITY_ID=

# Meta (Facebook) Pixel ID, e.g. 123456789012345
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# --- Search engine verification --------------------------------------------
# Google Search Console HTML-tag verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Yandex Webmaster verification token
NEXT_PUBLIC_YANDEX_VERIFICATION=

# --- Contact / lead routing -------------------------------------------------
# Where the contact form forwards leads. Leave blank to log-only in dev.
CONTACT_FORM_WEBHOOK_URL=
CONTACT_FORM_TO_EMAIL=admissions@globifytech.com

# Newsletter provider webhook (Mailchimp/Brevo/ConvertKit endpoint).
# Optional. Leads and subscribers are stored in Postgres either way; the
# webhook is now a notification, not the system of record.
NEWSLETTER_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# AI assistant (/contact/support)
#
# The assistant is a separate application — its own repository, its own
# database, its own admin console:
#   https://github.com/bitsolmarketing/Chat-Bot-Globify-tech-
#
# Origin of that deployment. `/contact/support` renders a chat surface in this
# site's design system and proxies every message to it server-side through
# `/api/support/chat`, so the visitor's connection never leaves globifytech.com.
#
# Leave it BLANK until the subdomain is actually serving. Unset is a state the
# support page renders honestly — it shows WhatsApp and the counsellor's number
# instead of a chat box that cannot answer.
#
# READ AT BUILD TIME. /contact/support is pre-rendered, so this value is baked
# in by `next build` — set it here (or in .env.production.local) and deploy,
# which rebuilds. Setting it only in the hPanel Node.js panel after the fact
# changes nothing on the page until the next build, even though the API route
# behind it will already be working.
AI_ASSISTANT_URL=

# ---------------------------------------------------------------------------
# Meta webhook (/api/webhooks/meta, also served at /webhook)
#
# One callback URL for the whole Meta developer app: WhatsApp Cloud API,
# Messenger and Instagram direct messages. This host is the public front door;
# the assistant above does the answering.
#
# Register in Meta and subscribe:
#   WhatsApp  > Configuration > Webhook   -> messages
#   Messenger > Settings > Webhooks       -> messages, messaging_postbacks
#   Instagram > Settings > Webhooks       -> messages
#
#   https://globifytech.com/webhook
# ---------------------------------------------------------------------------

# Any random string you invent. Type the SAME value into Meta's webhook form as
# the "Verify token"; Meta echoes it back on the GET handshake. One token covers
# all three products.   openssl rand -hex 16
META_VERIFY_TOKEN=

# App secret — Meta > App settings > Basic > App secret. Every delivery is
# signed with it. Without this the webhook rejects ALL traffic, deliberately:
# an unverified public webhook is an open door, so "not configured" must never
# mean "accept everything".
META_APP_SECRET=

# Instagram signs its webhook deliveries with the INSTAGRAM app secret, which
# is a different credential from META_APP_SECRET above — "Instagram API with
# Instagram login" issues the product its own app id and secret. Meta > your app
# > Instagram > API setup > Instagram app secret > Show.
#
# Unset, every Instagram delivery is rejected 401 before the body is parsed:
# nothing recorded, nothing answered, and WhatsApp still working, which reads
# like Instagram is not delivering rather than being turned away.
INSTAGRAM_APP_SECRET=


# ---------------------------------------------------------------------------
# The assistant  (src/lib/bot/*)
#
# The bot answers inside this application — the webhook above is both the front
# door and the brain. Everything here is read AT RUNTIME, so a change takes
# effect on the next message with no rebuild.
#
# Leaving a channel's token blank disables that channel cleanly: the delivery is
# still verified, recorded and turned into a lead, and the log says
# "acknowledged, not answered". It is never a crash and never a 500.
#
# `npm run bot:check` reports the state of everything below in one pass.
# ---------------------------------------------------------------------------

# Google AI Studio key — https://aistudio.google.com/apikey
# Without it the scripted flows (greeting, course list, admission, guidance)
# still work; open-ended questions fall back to a "we will follow up" notice.
GEMINI_API_KEY=
AI_MODEL=gemini-3-flash-preview
AI_MAX_TOKENS=1400

# WhatsApp Cloud API — Meta > WhatsApp > API Setup.
#
# WHATSAPP_PHONE_ID is the "Phone number ID" shown on that page, NOT the phone
# number itself. Prefer a System User token for WHATSAPP_TOKEN: the one offered
# on the API Setup page by default expires in 24 hours, which presents later as
# a bot that worked yesterday and is silent today.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# WhatsApp broadcasting — /admin/broadcasts
#
# Sending a broadcast needs only WHATSAPP_PHONE_ID and WHATSAPP_TOKEN above.
# Everything here makes it better behaved, and the admin says which parts are
# missing rather than failing at the moment of sending.
# ---------------------------------------------------------------------------

# The WhatsApp Business Account id — Meta > WhatsApp > API Setup, shown above
# the phone number list. NOT the phone number id.
#
# Only used to LIST approved templates, so the compose form can offer them as a
# dropdown with the real wording and the right number of variable boxes. Leave
# it blank and everything still sends; you type the template name and language
# by hand instead, and a typo is only discovered when Meta rejects the send.
#
# The token needs the `whatsapp_business_management` permission for this, which
# is separate from the `whatsapp_business_messaging` permission that sending
# uses. A token with only the latter lists nothing and says so.
WHATSAPP_WABA_ID=

# Messages per second. Cloud API's default ceiling is 80/second and exceeding it
# earns rate-limit errors rather than a queue, but that ceiling is shared with
# the assistant answering live conversations — so the default of 8 leaves the
# students who are actually talking to you at the front of the line.
WHATSAPP_BROADCAST_RATE=8

# The country code applied to local numbers: `0300 1234567` becomes
# `923001234567`. NEXT_PUBLIC_ because the compose form validates the pasted
# list in the browser with the same function the sender uses, so the count shown
# before saving is the count actually queued.
NEXT_PUBLIC_WHATSAPP_COUNTRY_CODE=92

# Shared secret for /api/cron/broadcasts, which starts scheduled broadcasts and
# finishes sends whose admin closed the tab.
#
# Generate one with: openssl rand -hex 32
#
# Leave it blank and the route refuses every scheduler — it never falls open,
# because a broadcast runner reachable without credentials is a spam cannon
# pointed at your own number. A signed-in admin can still call it either way.
#
# On Vercel, add to vercel.json:
#   { "crons": [{ "path": "/api/cron/broadcasts", "schedule": "*/5 * * * *" }] }
# Any other scheduler works too, as long as it sends:
#   Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Messenger — Meta > Messenger > Settings > Access tokens, generated for the
# Facebook Page. Blank means Messenger can receive but not reply.
FACEBOOK_PAGE_TOKEN=

# Instagram Graph API user token — Meta > Instagram > API setup with Instagram
# business login > Generate token. Starts `IGAA...`, and is a different kind of
# credential from the webhook secrets above: those prove *inbound* deliveries
# are genuine, this one authorises *outbound* replies to graph.instagram.com on
# the account's behalf.
#
# Instagram sends through graph.instagram.com, not graph.facebook.com. The wrong
# host fails with a permissions error that reads like a missing scope.
#
# It expires. A long-lived token lasts 60 days and is extended by calling
#   https://graph.instagram.com/refresh_access_token?grant_type=ig_refresh_token&access_token=...
# which returns a *new* string to paste back here. A token left unused for 60
# days cannot be refreshed at all — it has to be re-issued through the login
# flow, so treat the refresh as a diary entry, not a fallback.
INSTAGRAM_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Lead ingest (/api/leads/ingest)
#
# Shared secret the AI assistant signs with when it posts an enquiry it captured
# — an admission form filled in mid-conversation, a counselling session booked —
# so it lands in the same /admin/leads inbox as the contact form.
#
# Every request is an HMAC-SHA256 of the raw body:
#   X-Globify-Signature-256: sha256=<hmac>
#
# Unset means the endpoint refuses everything, deliberately: an open write into
# the admissions inbox is worse than a missing integration.
#   openssl rand -hex 32
LEAD_INGEST_SECRET=

# ---------------------------------------------------------------------------
# Database + admin (/admin) — Supabase Postgres
#
# Everything above stays optional. Everything below is REQUIRED to use the
# admin. Without DATABASE_URL the public site still builds and runs, falling
# back to the seed content in src/lib/*.ts and content/blog/, but the admin
# cannot sign in and contact-form submissions are only logged.
# ---------------------------------------------------------------------------

# Supabase Postgres connection string. Dashboard > Connect.
#
# Percent-encode reserved characters in the password — a literal `@` must be
# written as %40 or the URI parser reads everything after it as the host, and a
# `+` becomes a space.
#
# USE A POOLER HOST, not the direct one. Supabase offers three:
#
#   Transaction pooler  aws-0-<region>.pooler.supabase.com:6543   <- this
#   Session pooler      aws-0-<region>.pooler.supabase.com:5432   <- DIRECT_URL
#   Direct              db.<project-ref>.supabase.co:5432         <- avoid
#
# The direct host publishes an AAAA record and no A record, so it is reachable
# over IPv6 only unless the paid IPv4 add-on is enabled. On an IPv4-only network
# it fails as ENOTFOUND/ENETUNREACH, which reads like a typo in the hostname
# rather than a missing transport — an expensive hour to lose.
#
# Note the username differs by mode: the poolers want `postgres.<project-ref>`,
# the direct connection wants a bare `postgres`. The wrong one reports
# "Tenant or user not found", not an authentication error.
#
# This app's tables live in the `globify_site` schema rather than `public`, so
# the same database can host another application without a name collision.
DATABASE_URL=

# Where migrations run. Optional — falls back to DATABASE_URL when unset.
#
# Transaction pooling hands a different backend to each statement, which is
# wrong for DDL and advisory locks, so point this at the session pooler (5432)
# and leave DATABASE_URL on the transaction pooler (6543).
DIRECT_URL=

# Signing secret for the Auth.js session cookie.
# Generate one with:  npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET=

# Canonical origin for Auth.js callbacks. Only needed when the deployment URL
# is not auto-detected (most Vercel deploys can leave this blank).
# AUTH_URL=https://globifytech.com

# --- Admin account, read once by `npm run db:seed` --------------------------
# The password is hashed with bcrypt before it is stored; the plaintext never
# reaches the database. Re-running the seed updates the password in place, so
# this is also how you rotate it. Minimum 12 characters.
#
# QUOTE the password with single quotes if it contains `#`. dotenv treats an
# unquoted `#` as the start of a comment and will silently truncate the value,
# which produces a valid-looking hash of the wrong password.
#   ADMIN_PASSWORD='pa#ssword-with-hashes'
ADMIN_EMAIL=admin@globifytech.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Absolute path to a directory outside the deploy checkout, for admin-uploaded
# images (gallery, testimonials, authors, courses) to survive past this build.
# Optional — without it, uploads land in public/images/uploads inside the
# current checkout, which is fine for a host that deploys in place, but is
# silently wiped on any host (like this project's) where every deploy builds
# into a fresh directory. See scripts/link-uploads.mjs.
# UPLOADS_DIR=/home/USER/domains/example.com/uploads

# ---------------------------------------------------------------------------
# Learning portal (/portal, /student, /instructor)
#
# The portal is a second, independent Auth.js instance: its own table
# (portal_users), its own route (/api/portal-auth) and its own session cookie.
# It reuses AUTH_SECRET above — the two sessions stay cryptographically
# separate because Auth.js derives the JWT key from the cookie name, which
# differs. There is nothing extra to set for sign-in to work.
#
# Students register themselves at /portal/register. Instructor accounts are
# created by an administrator under /admin/portal-users, which generates a
# temporary password and shows it once.
# ---------------------------------------------------------------------------

# Optional, seed only. When set, `npm run db:seed` creates an instructor login
# for every author who leads a course, at <author-slug>@globifytech.com, with
# this password and the "must change on first sign-in" flag set.
#
# Accounts that already exist are never touched, so re-seeding cannot reset a
# working instructor's password. Minimum 12 characters. Leave blank to skip.
# PORTAL_SEED_PASSWORD=

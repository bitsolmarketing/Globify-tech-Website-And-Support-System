# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage

# next.js
/.next/
# Deploy staging and the previous build kept for rollback — see scripts/deploy.sh.
# Untracked but also invisible to `git status`, which matters because deploy.sh
# refuses to run against a dirty tree and would otherwise block itself.
/.next-build/
/.next-prev/
/.next-swapped/
/out/
next-env.d.ts

# production
/build

# generated media (recreated by `npm run assets`)
/public/images/generated

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# generated SQL holding credentials (admin bcrypt hash)
*.local.sql

# vercel
.vercel

# claude code local settings
.claude/settings.local.json

# typescript
*.tsbuildinfo

# Written by the deploy-confirm workflow step; also appears here if that step
# is ever run by hand in the checkout.
/configured.json
